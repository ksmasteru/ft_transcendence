{
  "info": {
    "name": "Chat Service API",
    "description": "Postman collection for testing chat service APIs in ft_trandandan microservices project",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "description": "Base URL for the API gateway"
    },
    {
      "key": "auth_token",
      "value": "",
      "description": "JWT token for authentication"
    },
    {
      "key": "chat_id",
      "value": "",
      "description": "Chat ID for testing"
    },
    {
      "key": "user_id",
      "value": "",
      "description": "User ID for testing"
    },
    {
      "key": "other_user_id",
      "value": "",
      "description": "Another user ID for testing group chats"
    }
  ],
  "item": [
    {
      "name": "Get All Chats",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/chats",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "chats"
          ]
        },
        "description": "Get all chats for the authenticated user, ordered by last message time"
      }
    },
    {
      "name": "Create Direct Chat",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{other_user_id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/v1/chats",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "chats"
          ]
        },
        "description": "Create a direct (1-on-1) chat with another user"
      }
    },
    {
      "name": "Create Group Chat",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"isGroup\": true,\n  \"name\": \"Test Group Chat\",\n  \"participantIds\": [\"{{other_user_id}}\"]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/v1/chats",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "chats"
          ]
        },
        "description": "Create a group chat with multiple participants"
      }
    },
    {
      "name": "Update Chat",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Updated Group Name\",\n  \"avatar\": \"https://example.com/avatar.jpg\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/v1/chats/{{chat_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "chats",
            "{{chat_id}}"
          ]
        },
        "description": "Update chat name and/or avatar (for group chats)"
      }
    },
    {
      "name": "Delete Chat",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/chats/{{chat_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "chats",
            "{{chat_id}}"
          ]
        },
        "description": "Delete a chat (user must be a participant)"
      }
    },
    {
      "name": "Add Participants to Group Chat",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userIds\": [\"{{user_id}}\", \"{{other_user_id}}\"]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/v1/chats/{{chat_id}}/participants",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "chats",
            "{{chat_id}}",
            "participants"
          ]
        },
        "description": "Add new participants to a group chat"
      }
    },
    {
      "name": "Remove Participant from Group Chat",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/chats/{{chat_id}}/participants/{{user_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "chats",
            "{{chat_id}}",
            "participants",
            "{{user_id}}"
          ]
        },
        "description": "Remove a participant from a group chat"
      }
    },
    {
      "name": "Get Chat Messages",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/chats/{{chat_id}}/messages?page=1&limit=50",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "chats",
            "{{chat_id}}",
            "messages"
          ],
          "query": [
            {
              "key": "page",
              "value": "1",
              "description": "Page number for pagination"
            },
            {
              "key": "limit",
              "value": "50",
              "description": "Number of messages per page"
            }
          ]
        },
        "description": "Get messages for a specific chat with pagination"
      }
    },
    {
      "name": "Send Text Message",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"Hello, this is a test message!\",\n  \"type\": \"text\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/v1/chats/{{chat_id}}/messages",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "chats",
            "{{chat_id}}",
            "messages"
          ]
        },
        "description": "Send a text message to a chat"
      }
    },
    {
      "name": "Send Image Message",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"https://example.com/image.jpg\",\n  \"type\": \"image\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/v1/chats/{{chat_id}}/messages",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "chats",
            "{{chat_id}}",
            "messages"
          ]
        },
        "description": "Send an image message to a chat"
      }
    },
    {
      "name": "Send File Message",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"https://example.com/document.pdf\",\n  \"type\": \"file\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/v1/chats/{{chat_id}}/messages",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "chats",
            "{{chat_id}}",
            "messages"
          ]
        },
        "description": "Send a file message to a chat"
      }
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// You can add pre-request scripts here",
          "// For example, to automatically set auth token from login response:",
          "// pm.environment.set(\"auth_token\", pm.response.json().token);"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Basic test to check if response is successful",
          "pm.test(\"Status code is success\", function () {",
          "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
          "});",
          "",
          "// Test for JSON response",
          "pm.test(\"Response is JSON\", function () {",
          "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
          "});",
          "",
          "// Auto-extract chat_id from create chat responses",
          "if (pm.response.code === 201 && pm.response.json().data && pm.response.json().data.id) {",
          "    pm.environment.set(\"chat_id\", pm.response.json().data.id);",
          "    console.log(\"Chat ID set to: \" + pm.response.json().data.id);",
          "}"
        ]
      }
    }
  ]
}
