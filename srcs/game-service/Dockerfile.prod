# Production image. Build context is srcs/ (see docker-compose.prod.yaml) so this
# Dockerfile can also reach the shared ../prisma schema + migrations.
FROM node:20-alpine AS builder

WORKDIR /usr/src/app
RUN apk add --no-cache openssl

COPY game-service/tools/package.json game-service/tools/package-lock.json ./
RUN npm ci

COPY game-service/tools/. .
RUN rm -rf ./prisma
COPY prisma ./prisma
RUN npx prisma generate

FROM node:20-alpine

WORKDIR /usr/src/app
RUN apk add --no-cache openssl

COPY game-service/tools/package.json game-service/tools/package-lock.json ./
# NODE_ENV=production must not be set before `npm ci` here - see sibling services'
# Dockerfile.prod for why (npm footgun with certain package.json shapes).
RUN npm ci --omit=dev

COPY game-service/tools/. .
RUN rm -rf ./prisma
COPY --from=builder /usr/src/app/node_modules/.prisma ./node_modules/.prisma

ENV NODE_ENV=production
RUN addgroup -S app && adduser -S app -G app && chown -R app:app /usr/src/app
USER app

# WebSocket port + HTTP API port
EXPOSE 9090 4003

# Migrations are applied once by the dedicated `migrate` service before this
# container starts (see docker-compose.prod.yaml); game-service only needs the
# generated Prisma client, not the schema/CLI, at runtime.
CMD ["node", "index.js"]
