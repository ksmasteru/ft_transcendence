# Production image. Build context is srcs/ (see docker-compose.prod.yaml) so
# sibling services' Dockerfile.prod can all follow the same COPY convention.
FROM node:20-alpine

WORKDIR /usr/src/app

COPY ./gateway/tools/package.json ./gateway/tools/package-lock.json ./
# NODE_ENV=production must not be set before `npm ci` - under some conditions (e.g. a
# package listed in both dependencies and devDependencies) it makes npm silently
# install almost nothing instead of erroring. Set it only after installing.
RUN npm ci --omit=dev

COPY ./gateway/tools/. .

ENV NODE_ENV=production
RUN addgroup -S app && adduser -S app -G app && chown -R app:app /usr/src/app
USER app

EXPOSE 3000

CMD ["node", "index.js"]